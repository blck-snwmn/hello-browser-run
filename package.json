{
  "name": "hello-browser-run",
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings .",
    "lint:fix": "oxlint --config .oxlintrc.json --deny-warnings . --fix",
    "rest:html": "node projects/rest-api/src/html.ts",
    "rest:url": "node projects/rest-api/src/url.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "25"
    }
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "packageManager": "pnpm@11.7.0"
}
